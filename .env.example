# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/environment-variables.md

ERPNEXT_IMAGE=ghcr.io/marcag3/erpnext-docker:v16

# Database Configuration
DB_PASSWORD=123

# Admin User Configuration (for first-time setup)
ADMIN_PASSWORD=admin

# User and Group ID Configuration (linuxserver.io approach)
# Set these to match your host system's user/group IDs to avoid permission issues
# Run 'id' command on your host to get your UID and GID
PUID=1000
PGID=1000
